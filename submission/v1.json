  "schema": {
    "action": {
      "additionalProperties": false,
      "description": "What the model sends: a calculator request or the final answer.",
      "properties": {
        "metadata": {
          "additionalProperties": true,
          "description": "Additional metadata for the action",
          "title": "Metadata",
          "type": "object"
        },
        "command": {
          "description": "\"calc\" evaluates an arithmetic expression; \"submit\" gives the final answer and ends the episode",
          "enum": [
            "calc",
            "submit"
          ],
          "title": "Command",
          "type": "string"
        },
        "text": {
          "description": "For calc: an expression using numbers, + - * / // % ** and brackets, e.g. \"(3/4 + 2) * 5\". For submit: an integer or reduced fraction, e.g. \"42\" or \"7/12\"",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "command",
        "text"
      ],
      "title": "MathArenaAction",
      "type": "object"
    },
